{
  "manifest_version": 3,
  "name": "Purrfect Download Manager",
  "version": "1.0",
  "description": "Intercepts downloads and sends them to PDM.",
  "permissions": [
    "downloads",
    "cookies",
    "webRequest",
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Purrfect Download Manager"
  }
}
