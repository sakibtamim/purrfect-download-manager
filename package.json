{
  "name": "purrfect-download-manager",
  "version": "0.1.2",
  "private": true,
  "engines": {
    "node": ">=20.18.0 || >=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "clean": "node scripts/kill-zombies.js",
    "dev:app": "pnpm run clean && pnpm run tauri dev",
    "setup": "node scripts/setup-sidecars.js",
    "package:extension": "node scripts/package-extension.js",
    "prepare": "husky",
    "version": "node scripts/sync-versions.js && git add src-tauri/tauri.conf.json src-tauri/Cargo.toml src-tauri/Cargo.lock packaging/archlinux/PKGBUILD extension/manifest.json",
    "postversion": "git push && git push --tags"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-dialog": "~2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-http": "~2.5.8",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "~2.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^22.13.9",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "shadcn": "^4.6.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "overrides": {
      "browserslist": "^4.29.6",
      "@babel/core": "^7.29.6",
      "source-map-js": "^1.2.2",
      "baseline-browser-mapping": "^2.11.0"
    }
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319"
}
