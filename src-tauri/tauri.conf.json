{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Purrfect Download Manager",
  "version": "0.1.2",
  "identifier": "com.purrfectsoftwareltd.pdm",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev",
    "beforeBuildCommand": "pnpm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Purrfect Download Manager",
        "width": 920,
        "height": 560,
        "minWidth": 700,
        "minHeight": 450,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Purrfect Software Limited",
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "externalBin": [
      "bin/pdm-aria2c",
      "bin/pdm-yt-dlp",
      "bin/pdm-ffmpeg"
    ],
    "icon": [
      "icons/128x128@2x.png",
      "icons/128x128.png",
      "icons/32x32.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
