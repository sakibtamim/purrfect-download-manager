{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://**" },
        { "url": "http://**" }
      ]
    },
    "store:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "bin/pdm-yt-dlp",
          "sidecar": true,
          "args": true
        },
        {
          "name": "bin/pdm-ffmpeg",
          "sidecar": true,
          "args": true
        },
        {
          "name": "bin/pdm-aria2c",
          "sidecar": true,
          "args": true
        },
        {
          "name": "explorer",
          "cmd": "explorer",
          "args": true
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$PICTURE/**" },
        { "path": "$VIDEO/**" },
        { "path": "$AUDIO/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "$DOWNLOAD/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$PICTURE/**" },
        { "path": "$VIDEO/**" },
        { "path": "$AUDIO/**" }
      ]
    },
    "shell:allow-open"
  ]
}