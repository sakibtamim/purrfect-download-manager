{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://**" },
        { "url": "http://**" }
      ]
    },
    "store:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "bin/pdm-yt-dlp",
          "sidecar": true,
          "args": true
        },
        {
          "name": "bin/pdm-ffmpeg",
          "sidecar": true,
          "args": true
        },
        {
          "name": "bin/pdm-aria2c",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}