# Maintainer: Sakib <sakib@purrfectsoftwareltd.com>
pkgname=purrfect-download-manager
pkgver=0.1.2
pkgrel=1
pkgdesc="A fast, steady, lightweight modern download manager built with Tauri and Next.js"
arch=('x86_64' 'aarch64')
url="https://github.com/sakibtamim/purrfect-download-manager"
license=('MIT')
depends=(
  'gtk3'
  'webkit2gtk-4.1'
  'libsoup3'
  'libayatana-appindicator'
  'openssl'
  'aria2'
  'yt-dlp'
  'ffmpeg'
  'xdg-utils'
  'hicolor-icon-theme'
)
optdepends=(
  'python-curl_cffi: browser impersonation for yt-dlp stream downloads'
  'atomicparsley: embed metadata and thumbnails into audio files'
)
makedepends=(
  'cargo'
  'nodejs>=20'
  'pnpm'
  'pkgconf'
  'git'
)
provides=('purrfect-download-manager')
conflicts=('purrfect-download-manager-bin')
source=(
  "$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
  "purrfect-download-manager.desktop"
)
# sha256sums are set to 'SKIP' during development and updated via 'updpkgsums' upon tagging a release
sha256sums=(
  'SKIP'
  'SKIP'
)

prepare() {
  cd "$pkgname-$pkgver"
  export PNPM_HOME="$srcdir/pnpm-home"
  pnpm fetch
  pnpm install --frozen-lockfile --offline

  local _triple
  _triple="$(rustc -vV | sed -n 's/host: //p')"
  cargo fetch --locked --manifest-path src-tauri/Cargo.toml --target "$_triple"

  # Satisfy tauri-build externalBin check on clean source tarballs;
  # Arch installs use system aria2, yt-dlp, and ffmpeg from depends().
  mkdir -p src-tauri/bin
  for _bin in pdm-aria2c pdm-yt-dlp pdm-ffmpeg; do
    if [ ! -e "src-tauri/bin/${_bin}-${_triple}" ]; then
      touch "src-tauri/bin/${_bin}-${_triple}"
      chmod +x "src-tauri/bin/${_bin}-${_triple}"
    fi
  done
}

build() {
  cd "$pkgname-$pkgver"
  export PNPM_HOME="$srcdir/pnpm-home"
  pnpm run build
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=src-tauri/target
  cargo build --frozen --release --manifest-path src-tauri/Cargo.toml
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=src-tauri/target
  cargo test --frozen --manifest-path src-tauri/Cargo.toml
}

package() {
  cd "$pkgname-$pkgver"
  
  # 1. Install Tauri compiled desktop binary
  install -Dm755 "src-tauri/target/release/PurrfectDownloadManager" \
    "$pkgdir/usr/bin/purrfect-download-manager"

  # 2. Install XDG Desktop Entry
  install -Dm644 "$srcdir/purrfect-download-manager.desktop" \
    "$pkgdir/usr/share/applications/purrfect-download-manager.desktop"

  # 3. Install Hicolor Icons across standard resolutions
  if [ -f "src-tauri/icons/32x32.png" ]; then
    install -Dm644 "src-tauri/icons/32x32.png" \
      "$pkgdir/usr/share/icons/hicolor/32x32/apps/purrfect-download-manager.png"
  fi
  if [ -f "src-tauri/icons/128x128.png" ]; then
    install -Dm644 "src-tauri/icons/128x128.png" \
      "$pkgdir/usr/share/icons/hicolor/128x128/apps/purrfect-download-manager.png"
  fi
  if [ -f "src-tauri/icons/128x128@2x.png" ]; then
    install -Dm644 "src-tauri/icons/128x128@2x.png" \
      "$pkgdir/usr/share/icons/hicolor/256x256/apps/purrfect-download-manager.png"
  fi
  if [ -f "src-tauri/icons/icon.png" ]; then
    install -Dm644 "src-tauri/icons/icon.png" \
      "$pkgdir/usr/share/icons/hicolor/512x512/apps/purrfect-download-manager.png"
  fi

  # 4. Install License if present
  if [ -f "LICENSE" ]; then
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  fi
}
